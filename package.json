{
  "name": "willwar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/stamp-sw.mjs && next dev",
    "build": "node scripts/stamp-sw.mjs && next build",
    "start": "next start",
    "preview": "node scripts/stamp-sw.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/stamp-sw.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "vitest run --project unit --project db",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:test": "supabase test db",
    "db:test:local": "vitest run --project db",
    "db:lint": "supabase db lint",
    "eval:ai": "vitest run --project eval",
    "content:check": "node scripts/content-check.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "idb": "^8.0.4",
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@opennextjs/cloudflare": "^1.20.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22"
  }
}
