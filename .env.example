# Copy to .env.local for development. Never commit real values.
# With the Supabase values empty, the app runs in device mode: everything is
# stored on this device only and pacts, Pro and the War Chest stake are off.

# Public (inlined at build time; must exist in the build environment)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
NEXT_PUBLIC_SEASON_MODE=nnn            # nnn | rolling
NEXT_PUBLIC_ADS_MODE=house             # house | adsense | h5
NEXT_PUBLIC_WAR_CHEST_MODE=promise     # off | promise | stake (stake only after legal sign-off)
NEXT_PUBLIC_PRICE_SEASON_INR=149       # display price, taxes included
NEXT_PUBLIC_PRICE_ANNUAL_INR=799

# Server only (Worker secrets: npx wrangler secret put NAME)
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ANNUAL_PLAN_ID=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
TURNSTILE_SECRET_KEY=
PRICE_SEASON_INR=149
PRICE_ANNUAL_INR=799
CRON_SECRET=                           # authenticates /api/cron/* calls (16+ chars)
